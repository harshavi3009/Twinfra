# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env (it is git-ignored).

# Supabase hosted Postgres (Session Pooler).
# Format: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Fallback: local/managed Postgres. Use the same format.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/twinfra

# Origins allowed by CORS. "*" is fine in dev (phone demo over LAN).
CORS_ORIGINS=*

# Where technician completion photos are stored and served at /uploads
UPLOAD_DIR=uploads
